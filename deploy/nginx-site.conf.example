# EXAMPLE ONLY; do not apply without review. Nginx usually includes site files in `http` context.
server {
    listen 127.0.0.1:8080;
    server_name _;
    auth_basic "DEVIL Cyber Command Center";
    auth_basic_user_file /opt/devil-intel/auth/users.htpasswd;
    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
}
